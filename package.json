{
  "name": "vite-plugin-shopify-theme",
  "version": "0.2.1",
  "description": "Wire a standard Shopify theme into Vite — HMR dev server + production bundle-metadata→snippet injection.",
  "keywords": [
    "hmr",
    "shopify",
    "shopify-theme",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/shopzend/vite-plugin-shopify-theme#readme",
  "bugs": {
    "url": "https://github.com/shopzend/vite-plugin-shopify-theme/issues"
  },
  "license": "MIT",
  "author": "woodawn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shopzend/vite-plugin-shopify-theme.git"
  },
  "bin": {
    "shopify-theme": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "check": "vp check",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "stub": "obuild --stub",
    "test": "vp test",
    "test:package": "node scripts/package-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "prepare": "obuild"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "jiti": "^2.7.0",
    "obuild": "^0.4.45",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  }
}
